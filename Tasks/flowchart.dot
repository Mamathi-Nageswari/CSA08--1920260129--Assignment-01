digraph validate {
  graph [rankdir=TB, fontname="Liberation Serif", nodesep=0.35, ranksep=0.3, dpi=200];
  node [fontname="Liberation Serif", fontsize=12, color="#333333", penwidth=1.1];
  edge [fontname="Liberation Serif", fontsize=11, color="#333333", arrowsize=0.7];
  start [group=main, label="START", shape=ellipse];
  read [group=main, label="INPUT farmer_id, shift, litres, fat, snf", shape=parallelogram];
  num [group=main, label="Are litres, fat and snf\nall numbers?", shape=diamond];
  qty [group=main, label="0 < litres <= 100 ?", shape=diamond];
  fat [group=main, label="2.0 <= fat <= 7.0 ?", shape=diamond];
  snf [group=main, label="7.0 <= snf <= 10.0 ?", shape=diamond];
  sh  [label="shift is M or E ?", shape=diamond];
  ok  [label="Entry is valid:\ncompute rate and amount", shape=box];
  out [group=main, label="OUTPUT rate, amount", shape=parallelogram];
  bad [label="OUTPUT \"invalid entry\" and the reason\nask the clerk to re-enter", shape=parallelogram];
  end [group=main, label="END", shape=ellipse];
  start -> read -> num;
  num -> qty [label=" yes"];  qty -> fat [label=" yes"];  fat -> snf [label=" yes"];
  snf -> sh [label=" yes"];   sh -> ok [label=" yes"];   ok -> out -> end;
  num -> bad [label=" no", tailport=e]; qty -> bad [label=" no", tailport=e]; fat -> bad [label=" no", tailport=e];
  snf -> bad [label=" no", tailport=e]; sh -> bad [label=" no", tailport=e];
  bad -> read [label=" re-enter", style=dashed, headport=e, constraint=false];
  {rank=same; fat; bad}
}
